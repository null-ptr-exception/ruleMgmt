{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "labels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "groupWait": {
          "type": "string",
          "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
          "minLength": 1
        },
        "groupInterval": {
          "type": "string",
          "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
          "minLength": 1
        },
        "repeatInterval": {
          "type": "string",
          "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "configs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "email"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "smarthost": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "authUsername": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "authPassword": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "key": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "name",
                      "key"
                    ],
                    "additionalProperties": false
                  },
                  "requireTLS": {
                    "type": "boolean"
                  },
                  "tlsConfig": {
                    "type": "object",
                    "properties": {
                      "insecureSkipVerify": {
                        "type": "boolean"
                      },
                      "ca": {
                        "type": "object",
                        "properties": {
                          "secret": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "pattern": "\\S"
                              },
                              "key": {
                                "type": "string",
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "name",
                              "key"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "secret"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  },
                  "sendResolved": {
                    "type": "boolean"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^[!-9;-~]+$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "text": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "html": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "to"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "webhook"
                  },
                  "url": {
                    "type": "string"
                  },
                  "urlSecret": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "key": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "name",
                      "key"
                    ],
                    "additionalProperties": false
                  },
                  "sendResolved": {
                    "type": "boolean"
                  },
                  "maxAlerts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "timeout": {
                    "type": "string",
                    "pattern": "^(0|([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
                    "minLength": 1
                  },
                  "authorization": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "credentials": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "\\S"
                          },
                          "key": {
                            "type": "string",
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "name",
                          "key"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "credentials"
                    ],
                    "additionalProperties": false
                  },
                  "basicAuth": {
                    "type": "object",
                    "properties": {
                      "username": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "\\S"
                          },
                          "key": {
                            "type": "string",
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "name",
                          "key"
                        ],
                        "additionalProperties": false
                      },
                      "password": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "\\S"
                          },
                          "key": {
                            "type": "string",
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "name",
                          "key"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "username",
                      "password"
                    ],
                    "additionalProperties": false
                  },
                  "tlsConfig": {
                    "type": "object",
                    "properties": {
                      "insecureSkipVerify": {
                        "type": "boolean"
                      },
                      "ca": {
                        "type": "object",
                        "properties": {
                          "secret": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "pattern": "\\S"
                              },
                              "key": {
                                "type": "string",
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "name",
                              "key"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "secret"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "shared": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "shared"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "match": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "configs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groupWait": {
            "type": "string",
            "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
            "minLength": 1
          },
          "groupInterval": {
            "type": "string",
            "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
            "minLength": 1
          },
          "repeatInterval": {
            "type": "string",
            "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
            "minLength": 1
          }
        },
        "required": [
          "match",
          "configs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "labels"
  ],
  "additionalProperties": false
}
