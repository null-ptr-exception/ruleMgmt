{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "_common": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "description": "Application team that owns this alert instance"
        },
        "namespace": {
          "type": "string",
          "description": "Kubernetes namespace",
          "default": "default"
        }
      },
      "required": [
        "owner",
        "namespace"
      ]
    },
    "mariadb_errors_aborted_clients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_rate": {
            "type": "number",
            "description": "Aborted clients/sec warning",
            "default": 3
          }
        }
      }
    },
    "mariadb_errors_aborted_connects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_rate": {
            "type": "number",
            "description": "Aborted connects/sec warning",
            "default": 3
          }
        }
      }
    },
    "mariadb_errors_connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_rate": {
            "type": "number",
            "description": "Connection errors/sec warning",
            "default": 5
          },
          "critical_rate": {
            "type": "number",
            "description": "Connection errors/sec critical",
            "default": 20
          }
        }
      }
    },
    "mariadb_latency_slow_queries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance_name": {
            "type": "string",
            "description": "Unique name for this alert instance (e.g. prod, staging)"
          },
          "warn_threshold": {
            "type": "number",
            "description": "Slow queries/sec warning",
            "default": 1
          },
          "critical_threshold": {
            "type": "number",
            "description": "Slow queries/sec critical",
            "default": 5
          }
        }
      }
    },
    "mariadb_saturation_buffer_pool": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_pct": {
            "type": "number",
            "description": "Buffer pool usage warning (%)",
            "default": 85
          },
          "critical_pct": {
            "type": "number",
            "description": "Buffer pool usage critical (%)",
            "default": 95
          }
        }
      }
    },
    "mariadb_saturation_connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_pct": {
            "type": "number",
            "description": "Connection saturation warning (%)",
            "default": 70
          },
          "critical_pct": {
            "type": "number",
            "description": "Connection saturation critical (%)",
            "default": 90
          }
        }
      }
    },
    "mariadb_saturation_cpu": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_pct": {
            "type": "number",
            "description": "CPU usage warning (%)",
            "default": 80
          },
          "critical_pct": {
            "type": "number",
            "description": "CPU usage critical (%)",
            "default": 95
          }
        }
      }
    },
    "mariadb_saturation_disk": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_pct": {
            "type": "number",
            "description": "Disk usage warning (%)",
            "default": 75
          },
          "critical_pct": {
            "type": "number",
            "description": "Disk usage critical (%)",
            "default": 90
          }
        }
      }
    },
    "mariadb_saturation_memory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_pct": {
            "type": "number",
            "description": "Memory usage warning (%)",
            "default": 80
          },
          "critical_pct": {
            "type": "number",
            "description": "Memory usage critical (%)",
            "default": 95
          }
        }
      }
    },
    "mariadb_traffic_network_receive": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_bytes": {
            "type": "number",
            "description": "Receive bytes/sec warning",
            "default": 104857600
          }
        }
      }
    },
    "mariadb_traffic_network_transmit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "warn_bytes": {
            "type": "number",
            "description": "Transmit bytes/sec warning",
            "default": 104857600
          }
        }
      }
    },
    "mariadb_traffic_qps_high": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "max_qps": {
            "type": "number",
            "description": "Maximum QPS threshold",
            "default": 10000
          }
        }
      }
    },
    "mariadb_traffic_qps_low": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "min_qps": {
            "type": "number",
            "description": "Minimum QPS threshold",
            "default": 10
          }
        }
      }
    }
  }
}
