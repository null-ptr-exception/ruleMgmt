{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlertForge output profiles (config/outputs.json)",
  "type": "object",
  "properties": {
    "outputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$",
        "not": {
          "const": "routing"
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "groupFields": {
            "type": "object",
            "propertyNames": {
              "not": {
                "enum": [
                  "name",
                  "rules",
                  "interval",
                  "limit",
                  "query_offset",
                  "labels",
                  "eval_offset",
                  "eval_delay",
                  "concurrency",
                  "eval_alignment",
                  "headers",
                  "notifier_headers",
                  "params"
                ]
              }
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "annotations": {
            "type": "object",
            "propertyNames": {
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?\\/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "not": {
                "const": "routing"
              }
            }
          },
          "validate": {
            "enum": [
              "promtool",
              "promtool3",
              "vmalert",
              "none"
            ]
          },
          "query": {
            "enum": [
              "promql",
              "metricsql",
              "logsql"
            ]
          },
          "groupKeys": {
            "type": "array",
            "items": {
              "enum": [
                "interval",
                "limit",
                "query_offset",
                "labels",
                "eval_offset",
                "eval_delay",
                "concurrency",
                "eval_alignment",
                "headers",
                "notifier_headers",
                "params"
              ]
            }
          }
        },
        "required": [
          "apiVersion",
          "kind",
          "validate",
          "query"
        ],
        "additionalProperties": false
      },
      "required": [
        "prometheus2"
      ]
    },
    "routing": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "apiVersion",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "outputs",
    "routing"
  ],
  "additionalProperties": false
}
