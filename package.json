{
  "name": "alertforge",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node scripts/dev-api.mjs\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "test": "vitest run",
    "test:pin": "vitest run --config tests/pin/vitest.config.mjs",
    "test:coverage": "node tests/coverage/unit.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "node tests/coverage/e2e.mjs",
    "build:coverage": "vite build --config tests/coverage/vite.config.mjs",
    "lint": "eslint 'src/**/*.{js,jsx}' 'server.js' 'server/**/*.js' 'scripts/**/*.mjs' --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lezer/highlight": "^1.2.3",
    "@prometheus-io/codemirror-promql": "^0.311.3",
    "ajv": "^6.15.0",
    "antd": "^6.4.2",
    "codemirror": "^6.0.2",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "yaml": "^2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^8.2.2",
    "eslint": "^10.3.0",
    "supertest": "^7.2.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
